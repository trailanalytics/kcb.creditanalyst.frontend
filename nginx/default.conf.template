# Strict-Transport-Security only on requests that arrived over TLS (a browser ignores it on plain http, and a development
# stack on http://localhost should not advertise it). One year, subdomains included.
map $scheme $hsts_header {
    default "";
    https   "max-age=31536000; includeSubDomains";
}

server {
    listen 80;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;

    # The largest upload the API takes without a rule of its own is 20 MB (SRS); the PR4 workbooks and the bureau feedback
    # files are bigger and get their own location below.
    client_max_body_size 21m;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # SPA and API share one origin, so the session and CSRF cookies need no CORS handling.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location ~ ^/api/v1/(analysis/pr4|output-files/) {
        client_max_body_size 100m;  # PR4 / feedback uploads
        proxy_pass ${API_UPSTREAM};
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
